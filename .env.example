# =============================================================================
#  Hornbill Smart Security Services — environment variables
# =============================================================================
#  Copy this file to .env.local and fill in the values. .env.local is
#  git-ignored; this file is committed and must never contain a real secret.
#
#  On Vercel the same variables go in Project → Settings → Environment
#  Variables. Set them for Production, Preview and Development.
# =============================================================================


# -----------------------------------------------------------------------------
#  CANONICAL ORIGIN
# -----------------------------------------------------------------------------
#  The one place the site's own address is defined. Sitemaps, canonical tags,
#  JSON-LD, OG tags and the quotation PDF all read it through
#  lib/seo/origin.ts, so attaching security.hornbilltech.co.ke later is a change
#  to this value and nothing else (docs/09 item 9).
#
#  Must be a full absolute origin including the scheme, with no trailing slash.
#    local       http://localhost:3000
#    preview     the Vercel preview URL for the branch
#    production  the Vercel production URL, then the custom domain when it lands
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
#  SUPABASE — public
# -----------------------------------------------------------------------------
#  Supabase dashboard → your project → Project Settings → API Keys
#  (or Settings → API on older dashboards).
#
#  Project URL. Looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

#  The "anon" / "publishable" key. Safe to ship to the browser: everything it
#  can reach is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
#  SUPABASE — secret
# -----------------------------------------------------------------------------
#  Same page, "service_role" / "secret" key. Click the eye icon to reveal it.
#
#  THIS KEY BYPASSES ROW LEVEL SECURITY. It can read items.cost_price. Never
#  give it a NEXT_PUBLIC_ prefix, never paste it into a client component, never
#  commit it. It is read in exactly one file, lib/supabase/admin.ts, and lint
#  fails if that changes (CLAUDE.md §2.3).
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
#  DATABASE — Drizzle
# -----------------------------------------------------------------------------
#  Supabase dashboard → Connect (top bar) → ORMs → Drizzle,
#  or Project Settings → Database → Connection string.
#
#  Pooled, "Transaction pooler" — port 6543, host contains `pooler`. This is
#  what the app uses at runtime. Replace [YOUR-PASSWORD] with the database
#  password you set when creating the project (Settings → Database → Reset
#  database password if you no longer have it). URL-encode any special
#  characters in the password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

#  Direct, "Session pooler" or "Direct connection" — port 5432. Used only by
#  drizzle-kit for migrations and by the seed script; pgBouncer in transaction
#  mode cannot run DDL reliably. Same password as above.
DATABASE_URL_DIRECT=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
